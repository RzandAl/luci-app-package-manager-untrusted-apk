@@ -87,6 +88,19 @@ case "$action" in
 				done
 			fi
 
+			if [ "$ipkg_bin" = "apk" ] &&
+			   [ "$requested_action" = "install" ] &&
+			   [ "$#" -eq 1 ] &&
+			   [ "$1" = "/tmp/upload.apk" ] &&
+			   [ "$(uci -q get luci-package-manager.main.allow_untrusted_uploads)" = "1" ]; then
+				cmd="$cmd --allow-untrusted"
+			fi
+
+			# Prevent package names and paths from being parsed as apk options.
+			if [ "$ipkg_bin" = "apk" ] && [ "$#" -gt 0 ]; then
+				set -- -- "$@"
+			fi
+
 			if flock -x 200; then
 				pkmcmd="$cmd $action $@"
